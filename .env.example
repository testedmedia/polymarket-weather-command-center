# Leave everything below unset to run in DEMO MODE: `npm run dev` will serve
# a bundled synthetic sample payload (lib/demo-data.ts) so the dashboard
# renders fully populated with no engine required. See README "Demo mode".
#
# Point at your own weather-intelligence engine to go live:
UPSTREAM_BASE=https://your-engine.example.com
UPSTREAM_SECRET=your-bearer-token

# Optional override — DEMO=1 forces the sample payload on even if
# UPSTREAM_BASE is set; DEMO=0 forces it off (upstream fetch failures surface
# as real 502s instead of being masked by sample data).
# DEMO=1

# Optional — gates the whole app behind a password (see middleware.ts).
# Leave both unset for open local dev.
# ACCESS_PASSWORD=change-me
# AUTH_SECRET=change-me-too
